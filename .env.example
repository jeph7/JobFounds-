# ==============================================================================
# JOBFOUNDS — Variables d'environnement réelles (Hostinger Unlimited Node.js 22)
# Remplissez ces variables dans :
# Hostinger hPanel -> Sites Web -> jobfounds.com -> Node.js -> Variables d'environnement
# Note : Firebase Auth & Firestore fonctionnent déjà via firebase-applet-config.json
#        (aucun compte de service FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY requis).
# Ne committez JAMAIS vos vraies clés dans Git.
# ==============================================================================

# 1. Production & Domaine officiel (OBLIGATOIRES)
NODE_ENV="production"
APP_URL="https://jobfounds.com"
GEMINI_API_KEY="COLLEZ_VOTRE_CLE_GEMINI_ICI"

# 2. Adaptation Hostinger Unlimited (Cron Jobs + SQLite persistant hors build)
# WORKER_MODE="cron" désactive la boucle permanente et s'appuie sur les Cron Jobs Hostinger
WORKER_MODE="cron"
# Jeton secret (>= 16 caractères) pour sécuriser l'endpoint HTTP /api/cron/tick
CRON_SECRET="GENERER_UNE_CHAINE_ALEATOIRE_DE_32_CARACTERES"
# Chemin absolu persistant hors dossier de déploiement pour SQLite (ex: /home/u123456789/jobfounds_data)
JOBFOUNDS_DATA_DIR=""

# 3. Envoi d'e-mails transactionnels & candidatures Resend (https://resend.com/api-keys)
# Configurez un domaine vérifié (SPF + DKIM) dans Resend (ex: jobfounds.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="JOBFOUNDS <candidatures@jobfounds.com>"
# Alias rétro-compatible optionnel :
NOTIFICATION_FROM_EMAIL="JOBFOUNDS <alerts@jobfounds.com>"
# Commande Cron Hostinger recommandée (toutes les 15 minutes) :
# cd ~/domains/jobfounds.com/nodejs && node dist-server/cron-worker.mjs

# 4. Sécurité coffre-fort déploiement & gouvernance IA (RECOMMANDÉS)
# Liste optionnelle d'e-mails administrateurs supplémentaires séparés par des virgules
ADMIN_EMAILS=""
DEPLOY_VAULT_SECRET=""
ENGINE_DEFAULT_MONITOR_MINUTES="720"
AI_DAILY_MAX_CALLS="100"
AI_DAILY_MAX_COST_USD="3"
PORT="3000"


