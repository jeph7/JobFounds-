{
  "name": "jobfounds",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist-server/server.mjs && esbuild scripts/cron-worker.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist-server/cron-worker.mjs",
    "build": "npm run build:client && npm run build:server",
    "start": "node server.js",
    "cron:tick": "node scripts/cron-worker.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "basic-ftp": "^6.2.6",
    "docx": "^9.16.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.0",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.15.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
